# Used today by app/config.py
DATABASE_URL=postgresql://postgres:password@localhost:5432/yns_db
FRONTEND_URL=http://localhost:3000

# Gemini via Vertex AI — no API key. Auth is via Application Default
# Credentials: run `gcloud auth application-default login` locally
# (against the yns-interview-staging project); Cloud Run supplies ADC
# automatically from the yns-api-runtime service account.
GCP_PROJECT_ID=yns-interview-staging
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash-lite

# Target for Phase 4 (FastAPI routes / auth) — not read by config.py yet,
# see claude.md "Environment variables" and its rule #7 open item.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# No SUPABASE_JWT_SECRET — verify tokens against the project's public JWKS
# endpoint (SUPABASE_URL + /auth/v1/.well-known/jwks.json), not a shared secret.
ALLOWED_ORIGINS=http://localhost:3000
