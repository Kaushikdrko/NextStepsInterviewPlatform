# Used by app/config.py
DATABASE_URL=postgresql://postgres:password@localhost:5432/yns_db
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Gemini via Vertex AI -- no API key. Auth is via Application Default
# Credentials locally, and via the Cloud Run runtime service account in GCP.
GCP_PROJECT_ID=yns-interview-staging
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash-lite

# Still needed while resume file bytes remain in Supabase Storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Sign-up OTP email
RESEND_API_KEY=
OTP_FROM_EMAIL=YNS <onboarding@example.com>
